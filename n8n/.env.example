# Copy to n8n/.env (git-ignored). Read by docker-compose.yml.

# The same value as N8N_SHARED_SECRET in the app's .env.local. At least 16
# characters; generate one with:  openssl rand -hex 32
N8N_SHARED_SECRET=

# The From address for published emails — normally the SMTP account itself.
FANOUT_SMTP_FROM=

# OPTIONAL — where n8n reaches the app. The default works with `pnpm dev`.
# FANOUT_APP_URL=http://host.docker.internal:3000

# OPTIONAL — time zone of the n8n UI and its logs.
# GENERIC_TIMEZONE=Europe/Belgrade
