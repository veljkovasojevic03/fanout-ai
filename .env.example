# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=              # server only
SUPABASE_DB_URL=                        # OPTIONAL — Postgres connection string, only for `pnpm test:db:remote`
NEXT_PUBLIC_TURNSTILE_SITE_KEY=         # empty = no CAPTCHA widget (only works while CAPTCHA is off in Supabase Auth)
ANTHROPIC_API_KEY=                      # OPTIONAL — empty = Sample mode only
LLM_MODEL_FREE=claude-haiku-4-5         # Free/guest plan model
LLM_MODEL_PRO=claude-sonnet-5-5         # Pro plan model
DAILY_REAL_GENERATION_CAP=30
DAILY_REAL_REFINE_CAP=                  # OPTIONAL — live refinements per day; empty = 5 × the generation cap
DEMO_FORCE_SAMPLE=false
STRIPE_SECRET_KEY=                      # test mode only (sk_test_…) — a live key is refused
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
CRON_SECRET=
N8N_BASE_URL=                           # OPTIONAL — empty = simulated dispatcher
N8N_SHARED_SECRET=
